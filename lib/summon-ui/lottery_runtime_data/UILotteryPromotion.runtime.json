 "textMeshes": [
  {
   "go": "Back00",
   "text": "milim\nhakainoboukun nofutatsunawomotsuryuumajin\nsaikonomaounohitori rimurugatadamonodenaikotowominuki\nmizukarasugatawoarawasu\ntempestwo otozuretasai　rimurutoyuugiwomusubi\"mabudachi\"tonaru\nrimurunisukk",
   "fontSize": 32.900001525878906,
   "fontColor": {
    "r": 1.0,
    "g": 1.0,
    "b": 1.0,
    "a": 1.0
   },
   "fontMaterial": null
  },
  {
   "go": "Front01",
   "text": "shion\nmitameha coolbeautydaga\nsonosentouryokuhatakai\nrimurukaramoratta gourikimaru toiunanodaitouwo aiyoushiteiru\n\n\n\n\n\n\n\n\n\n\nmitameha coolbeautydaga\nsonosentouryokuhatakai\ngourikimaru",
   "fontSize": 72.12000274658203,
   "fontColor": {
    "r": 1.0,
    "g": 0.3607843137254902,
    "b": 0.9607843137254902,
    "a": 1.0
   },
   "fontMaterial": null
  },
  {
   "go": "Back01",
   "text": "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nbenimaru\noakzokuniyotte horobosareta ogrezokuzokuchounomusuko\nshinkunokamitohitomi shikkokunotsunowomotsu\nseigikannotsuyoiseikakude\nyurusenaikotonihamassugunitachimukau\nr",
   "fontSize": 31.950000762939453,
   "fontColor": {
    "r": 1.0,
    "g": 1.0,
    "b": 1.0,
    "a": 1.0
   },
   "fontMaterial": null
  },
  {
   "go": "Middle00",
   "text": "\nrimuru tempest\nsalaryman mikamisatoruha jikennimakikomare\nisekainitenseishite slimeni\ntenseijiniminitsuita uniqueskill daikenja to\nhoshokusha wotayorini\nsamazamananouryokuwokakutokushiteiku\n\njikennim",
   "fontSize": 46.849998474121094,
   "fontColor": {
    "r": 1.0,
    "g": 1.0,
    "b": 1.0,
    "a": 1.0
   },
   "fontMaterial": null
  },
  {
   "go": "Middle01",
   "text": "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nrigurud\ngoblinmuranosonchou\ngarouzokunoshuugekiniatamawonayamase\nsonotatakaidemusukomohitoriushinatteiru\nrimurukaranadukerare hobgoblinninattakotode\nkinkotsuryuuryuunosugatahetohenkashi",
   "fontSize": 43.900001525878906,
   "fontColor": {
    "r": 1.0,
    "g": 1.0,
    "b": 1.0,
    "a": 1.0
   },
   "fontMaterial": null
  },
  {
