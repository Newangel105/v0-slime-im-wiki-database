# Base URL for media (videos, movies, prerender clips) hosted on the
# external CDN (Cloudflare R2). Used by lib/media-cdn.ts to prefix paths
# starting with /Movie/ or /Video/ at runtime.
#
# Leave UNSET in local dev — paths fall back to Next.js serving from
# public/Movie/ + public/Video/.
#
# In production (Vercel project env vars) set this to the R2 public URL,
# e.g.:
#   NEXT_PUBLIC_MEDIA_CDN=https://media.slimewiki.app
#   (or the default https://<account>.r2.dev/<bucket> if no custom domain)
#
# No trailing slash. lib/media-cdn.ts strips any trailing slash defensively.
NEXT_PUBLIC_MEDIA_CDN=
