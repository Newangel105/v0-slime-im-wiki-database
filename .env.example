# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values you use. Only NEXT_PUBLIC_MEDIA_CDN
# is needed to see media/data; everything else enables an optional feature.
# Real values go in `.env` (gitignored) — never commit them.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL of the bucket/CDN that hosts media (/Movie, /Video) and the bulk
# game-data JSON. No trailing slash (lib/media-cdn.ts strips one defensively).
# Leave BLANK in local dev to serve from public/Movie + public/Video instead.
#   e.g. NEXT_PUBLIC_MEDIA_CDN=https://media.example.com
NEXT_PUBLIC_MEDIA_CDN=

# Supabase — powers the Guides section (schema in supabase/). Optional.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Discord /character slash command (app/api/discord). Optional.
# Set the Interactions Endpoint URL in the Discord dev portal to <site>/api/discord/
DISCORD_PUBLIC_KEY=
DISCORD_APP_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_SITE_URL=

# GitHub-backed guide content. Optional.
GITHUB_TOKEN=
GIST_ID=
